# Copy to .env and adjust as needed.

# Seconds an inbox session is kept in memory without any request touching it
INBOX_TTL_SECONDS=3600

# SSE stream: seconds between upstream checks for new mail
POLL_INTERVAL_SECONDS=5

# Comma-separated list of enabled providers (empty = all)
# Available: mailtm, mailgw, guerrilla
ENABLED_PROVIDERS=

# CORS origins allowed to call the API (empty = only the same host's static files)
CORS_ORIGINS=

# New inboxes per client IP per minute (0 = unlimited). Behind a reverse proxy
# every client shares the proxy's IP - run uvicorn with --proxy-headers then.
CREATE_LIMIT_PER_MINUTE=10

# Inboxes held in memory at once (0 = unlimited)
MAX_INBOXES=500
