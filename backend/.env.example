# Kopiju uz .env un pielāgo pēc vajadzības

# Cik ilgi (sekundēs) inbox sesija tiek turēta serverī bez pieprasījumiem
INBOX_TTL_SECONDS=3600

# SSE / polling intervāls sekundēs (cik bieži prasām providerim jaunas vēstules)
POLL_INTERVAL_SECONDS=5

# Ar komatu atdalīts atļauto provideru saraksts (tukšs = visi)
# Pieejamie: mailtm, mailgw, guerrilla
ENABLED_PROVIDERS=

# CORS - atļautie origini frontend-am (tukšs = tāda paša host-a static faili)
CORS_ORIGINS=
